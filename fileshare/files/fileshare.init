#!/bin/sh /etc/rc.common
# FileShare (Go) init for OpenWrt

START=99
STOP=10

USE_PROCD=1

SERVICE_DIR=/usr/lib/fileshare
BIN=/usr/bin/fileshare

log_fs() {
	logger -t fileshare "$@"
}

ensure_openssl() {
	command -v openssl >/dev/null 2>&1 && return 0
	opkg list-installed 2>/dev/null | grep -q "^openssl-util" && return 0
	log_fs "尝试安装 openssl-util..."
	opkg update 2>&1 | log_fs
	opkg install openssl-util 2>&1 | log_fs || log_fs "警告: 未安装 openssl-util，HTTPS 可能不可用"
}

start_service() {
	. /lib/functions.sh
	config_load fileshare

	local enabled
	config_get_bool enabled config enabled 1
	[ "$enabled" = "0" ] && return 0

	[ -x "$BIN" ] || { log_fs "错误: $BIN 不存在"; return 1; }
	ensure_openssl

	log_fs "启动 fileshare (Go)"

	procd_open_instance
	procd_set_param command "$BIN"
	procd_set_param env FILESHARE_DIR="$SERVICE_DIR"
	procd_set_param cwd "$SERVICE_DIR"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_set_param respawn_threshold 3600
	procd_set_param respawn_timeout 10
	procd_close_instance

	log_fs "服务已启动"
}

reload_service() {
	stop
	sleep 1
	start
}

service_triggers() {
	procd_add_reload_trigger "fileshare"
}
